{
  // source/ui/host/, the editor's and the board's host: their asks made
  // into the core's commands, and the core's state into what they draw,
  // each editor's own file and mode beside; it draws nothing itself, but
  // reads the editor's and the board's types through their indexes, so the
  // DOM's types, with what source/ declares for their stylesheets and the
  // editor's EditContext; it runs in a page
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["./**/*", "../../stylesheets.d.ts", "../editor/editContext.d.ts"]
}
