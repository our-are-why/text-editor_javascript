{
  // source/shell/, what puts the parts together and tells the editor and the
  // board what to show: it draws nothing and runs in the browser or in Bun,
  // its host's, using neither; the DOM's types only as the editor's and the
  // board's are read through their indexes, so what source/ declares for the
  // stylesheets their parts import, and the editor's EditContext, with them
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["./**/*", "../stylesheets.d.ts", "../editor/editContext.d.ts"]
}
